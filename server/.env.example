# Copy this file to .env and fill in your OWN Foundry key.
# Never paste a real key into chat, commit it, or put it in client-side code —
# this server exists specifically so the key stays server-side only.
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=genai-demos-resource
CLAUDE_DEPLOYMENT=claude-opus-4-8
# The client's vite.config.ts dev proxy is hardcoded to :4300 — change both
# together if you ever need a different port.
PORT=4310
